{
  "name": "scorecards-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "start": "node server.js",
    "gcp-build": "echo 'Skipping App Engine Cloud Build; dist/ is prebuilt and uploaded'",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "render:fixtures": "vite-node scripts/renderFixtures.ts",
    "bench": "node --expose-gc ./node_modules/vite-node/dist/cli.mjs scripts/bench.ts --"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "@google-cloud/secret-manager": "^7.1.1",
    "@react-pdf/renderer": "^4.9.0",
    "buffer": "^6.0.3",
    "express": "^5.1.0",
    "fflate": "^0.8.3",
    "helmet": "^8.3.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.52.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/qrcode": "^1.5.6",
